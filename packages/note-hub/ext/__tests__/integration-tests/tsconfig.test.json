{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "../_out-tsc",
        "rootDir": "./suite",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "composite": false,
        "declaration": false,
        "declarationMap": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": [
        "./suite/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "_out-tsc"
    ]
}