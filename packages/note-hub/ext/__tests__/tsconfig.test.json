{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "./_out-tsc",
        "rootDir": "./integration-tests",
        "module": "CommonJS",
        "moduleResolution": "Node",
        "declaration": false,
        "declarationMap": false,
        "sourceMap": true,
        "esModuleInterop": true,
        "resolveJsonModule": true
    },
    "include": [
        "./integration-tests/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "_out-tsc"
    ]
}